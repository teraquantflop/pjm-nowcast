# Server-safe configuration. Copy to .env for local runs.
PORT=8000
ENV=development

DATA_DIR=./var
# DATABASE_PATH=./var/pjm-nowcast.sqlite

PUBLIC_BASE_URL=http://localhost:8000
# PUBLIC_ICON_URL=

CORS_ORIGIN=
TRUST_PROXY=false

RUN_POLLER=true
POLL_INTERVAL_SECONDS=1800
POLL_JITTER_SECONDS=60
POLL_URL=https://www.pjm.com/markets-and-operations
REQUEST_TIMEOUT_SEC=25
MOCK_MODE=false
POLL_CARRY_FORWARD=false

RETENTION_DAYS=30
MAX_HISTORY_DAYS=30
STALE_AFTER_SECONDS=10800
ZONAL_ZONES=BGE,COMED,DOM,PEPCO,PSEG,JCPL

# Public receive addresses only. Never put spending keys on the server.
PAY_TO_SVM_ADDRESS=
PAY_TO_EVM_ADDRESS=
# PAY_TO_EVM_ADDRESS is Base (eip155:8453) only. Do not reuse it for Polygon.
POLY_PAY_TO=
# PAY_TO_ADDRESS=   # optional single-network alias (not Polygon)
NETWORKS=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp,eip155:8453,eip155:137
FACILITATOR_URL=https://facilitator.payai.network
PRICE_L1=$0.02
PRICE_L2=$0.10
PRICE_L3=$0.25

FREE_DEMO_ENABLED=true
FREE_TIER_N=0
FREE_TIER_WINDOW_SECONDS=86400
FREE_TIER_SALT=pjm-nowcast-free-tier

MCP_ENABLED=true
MCP_PATH=/mcp

RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=20

# Optional PayAI merchant API credentials (not chain keys)
# PAYAI_API_KEY_ID=
# PAYAI_API_KEY_SECRET=

# Optional Coinbase CDP facilitator (Base). Both required to enable.
# If unset, PayAI is used for Base and Solana.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

SPREAD_ABS_USD=15
SPREAD_K=1.25
# SNAPSHOT_PATH=./var/snapshot.json

# One-shot HMM repair. On Railway: set to 1, redeploy/restart, confirm a
# log line with finite entropy, then DELETE this variable so the next
# restart does not wipe HMM arrays again.
# PJM_NOWCAST_RESET_HMM=1

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# CLIENT ONLY — do not set these on the server process.
# The API refuses to start if they are present.
# EVM_PRIVATE_KEY=
# SVM_PRIVATE_KEY=
# ---------------------------------------------------------------------------
